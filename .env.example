# JARVIS AI Assistant - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- LLM / AI Provider ---
# Choose your AI provider: "anthropic" (Claude), "openai", or "frellapi" (FreeLLMAPI local proxy)
JARVIS_AI_PROVIDER=anthropic

# Anthropic Claude API key (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenAI API key (optional, only if JARVIS_AI_PROVIDER=openai)
OPENAI_API_KEY=

# Model to use (defaults below; override if needed)
# NOTE: When using FreeLLMAPI (frellapi), this model name MUST match one of the
# models configured in FreeLLMAPI. The default "claude-3-5-sonnet-20241022" may
# not be valid unless explicitly mapped in your FreeLLMAPI instance.
JARVIS_MODEL=claude-3-5-sonnet-20241022

# --- FreeLLMAPI (local Anthropic-compatible proxy) ---
# Enable by setting JARVIS_AI_PROVIDER=frellapi
# FreeLLMAPI endpoint (default documented value; verify your server runs here)
JARVIS_FLLMAPI_BASE_URL=http://localhost:3001
# FreeLLMAPI API key (if required by your FreeLLMAPI setup)
JARVIS_FLLMAPI_API_KEY=

# --- Speech ---
# TTS voice rate (words per minute, 0-200 scale via pyttsx3; default is 200)
JARVIS_TTS_RATE=150
# TTS volume (0.0 to 1.0)
JARVIS_TTS_VOLUME=0.9
# Preferred language for speech recognition and synthesis
JARVIS_LANGUAGE=it-IT
# Optional microphone index (integer). Uncomment to force a specific microphone device.
# To list available device indices, run:
# python -c "import speech_recognition as sr; print(sr.Microphone.list_microphone_names())"
# JARVIS_MICROPHONE_INDEX=1

# --- Application Behavior ---
# Window always-on-top on desktop
JARVIS_ALWAYS_ON_TOP=true
# Show system tray icon
JARVIS_SYSTEM_TRAY=true
# Log level: DEBUG, INFO, WARNING, ERROR
JARVIS_LOG_LEVEL=INFO