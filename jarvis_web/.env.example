# Copiare questo file in .env e inserire solo la chiave del provider scelto.
JARVIS_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Per Gemini, impostare JARVIS_LLM_PROVIDER=gemini e usare GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Per Ollama locale, impostare JARVIS_LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

LOG_LEVEL=INFO